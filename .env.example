# Public API URL used by the browser (change this when using a tunnel like Cloudflare/ngrok)
NEXT_PUBLIC_API_URL=http://localhost:8082/api

# Internal API URL used by Next.js server-side code (inside Docker)
INTERNAL_API_URL=http://host.docker.internal:8082/api

# Centrifugo WebSocket URL used by the browser
NEXT_PUBLIC_CENTRIFUGO_URL=ws://localhost:8000/connection/websocket

# Optional: Giphy API key for GIF picker
GIPHY_API_KEY=
